{
  "manifest_version": 3,
  "name": "Thanos for Meet",
  "version": "1.0.0",
  "description": "Исчезни из кадра в Google Meet и Discord: камера показывает пустую комнату. С режимом Таноса — рассыпаешься в пыль.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://meet.google.com/*", "https://discord.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*", "https://discord.com/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://meet.google.com/*", "https://discord.com/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-vanish": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "Исчезнуть / вернуться"
    },
    "capture-room": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Снять пустую комнату (через 3 секунды)"
    }
  }
}
