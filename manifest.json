{
  "manifest_version": 3,
  "name": "Clawd for Meet",
  "version": "1.0.0",
  "description": "Вместо тебя в Google Meet — Clawd, маскот Claude Code: следит за головой, моргает и шевелит ртом, когда ты говоришь.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "src/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-mascot": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Включить / выключить маскота"
    },
    "capture-room": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Снять пустую комнату (через 3 секунды)"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "detector/*",
        "vendor/*"
      ],
      "matches": [
        "https://meet.google.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
